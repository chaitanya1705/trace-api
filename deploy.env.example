# Environment for the hosted API container (Railway; Render and Fly also work). Secret-free template; see docs/DEPLOYMENT.md.
TRACE_ENV=production
AUTH_MODE=off
ALLOW_OPEN_ACCESS=true            # no login: anyone who can reach the API has full access

DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres   # Supabase: session pooler (5432) or direct
AUTO_MIGRATE=true

NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

OPENAI_API_KEY=
TRACE_MODEL=gpt-4o-mini

TRACE_SECRET_KEY=                 # python -m app.cli gen-secret-key
TRACE_SECRET_KEY_VERSION=1

TRACE_PUBLIC_ORIGIN=https://<api-host>
TRACE_WEB_ORIGIN=https://<web>.vercel.app
TRACE_ALLOWED_ORIGINS=https://<web>.vercel.app

GITHUB_APP_ID=5348735
GITHUB_APP_PRIVATE_KEY=           # python -m app.cli pem-oneline secrets/traceai-app.pem
GITHUB_WEBHOOK_SECRET=

PULSELAB_URL=
SHOPFLOW_WEB_URL=
SHOPFLOW_API_URL=
# PORT is provided by the host.
