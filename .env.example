# Secret-free template. Copy to .env (git-ignored). Names follow architecture A13.
TRACE_ENV=development            # development | test | production (production requires every block below)

# Identity. Local development uses plain Postgres and no Supabase:
#   AUTH_MODE=local  -> POST /api/v1/dev/token {"email": "..."} returns a bearer token (refused when TRACE_ENV=production)
#   AUTH_MODE=supabase (default, production) -> SUPABASE_* below
AUTH_MODE=off
LOCAL_AUTH_SECRET=change-me-to-a-long-random-string
# First owner (sign-up alone grants nothing):  python -m app.cli bootstrap-org --name Acme --owner-email you@example.com

# Control plane (any Postgres locally; Supabase Postgres in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# Evidence graph (Neo4j)
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Model
OPENAI_API_KEY=
TRACE_MODEL=gpt-4o-mini

# Credential vault: 32 random bytes, urlsafe base64. Generate with:
#   python -c "from app.storage.secrets import generate_key; print(generate_key())"
TRACE_SECRET_KEY=
TRACE_SECRET_KEY_VERSION=1
# TRACE_SECRET_KEYS_PREVIOUS=1:<old key>   # only while re-encrypting after a rotation

TRACE_PUBLIC_ORIGIN=http://localhost:8000
TRACE_ALLOWED_ORIGINS=http://localhost:3000

# GitHub: two separately provisioned apps. The read app is used by indexing; the remediation app (P3) never is.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=      # e.g. ./secrets/trace-app.pem (git-ignored); use this OR the line above
GITHUB_WEBHOOK_SECRET=
GITHUB_REMEDIATION_APP_ID=
GITHUB_REMEDIATION_PRIVATE_KEY=

# Demo apps built separately (PulseLab = traffic generator, ShopFlow = target system). Leave blank until deployed.
PULSELAB_URL=
SHOPFLOW_WEB_URL=
SHOPFLOW_API_URL=
